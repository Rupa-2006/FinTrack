{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fintrack-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/server.js"],
      "port": 5000
    },
    {
      "name": "fintrack-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5180
    },
    {
      "name": "fintrack-ai",
      "runtimeExecutable": "ai-service/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "--factory", "app.main:create_app", "--app-dir", "ai-service", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
