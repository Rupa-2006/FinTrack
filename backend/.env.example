# Copy to backend/.env and fill in. Placeholders only: never commit real values.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# --- MySQL (runtime account: least privilege, never root) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fintrack
DB_USER=fintrack_app
DB_PASSWORD=replace_with_app_user_password
DB_POOL_SIZE=10
# TLS to MySQL. Must be true in production when the database is on another machine.
# The provider's CA certificate: DB_SSL_CA (PEM text, \n for line breaks) or DB_SSL_CA_FILE (path).
# With neither, the system's trusted CAs are used. Verification is never switched off.
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=
# Hosts the app account connects from; the migration runner grants privileges for each
DB_APP_HOSTS=localhost,127.0.0.1

# --- MySQL (migration account: used only by scripts/migrate.js) ---
DB_MIGRATOR_USER=fintrack_migrator
DB_MIGRATOR_PASSWORD=replace_with_migrator_password

# --- MySQL (read-only backup account, used by mysqldump) ---
DB_BACKUP_USER=fintrack_backup
DB_BACKUP_PASSWORD=replace_with_backup_password

# --- Tokens ---
JWT_ACCESS_SECRET=replace_with_64_hex_chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Field encryption (AES-256-GCM). Format: version:64hex[,version:64hex] ---
ENCRYPTION_KEYS=1:replace_with_64_hex_chars
ENCRYPTION_ACTIVE_KEY_VERSION=1

# --- Audit hash chain (HMAC-SHA256 key, 64 hex chars) ---
AUDIT_HMAC_KEY=replace_with_64_hex_chars

# --- CORS / CSRF origin allow-list (comma separated) ---
CLIENT_ORIGINS=http://localhost:5180

# --- AI service (internal) ---
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SHARED_SECRET=replace_with_64_hex_chars

# --- Exchange rates ---
FX_API_URL=https://api.frankfurter.dev/v1

# --- Email (leave SMTP_HOST empty in development: mails are written to backend/tmp/) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FinTrack <no-reply@example.com>
APP_PUBLIC_URL=http://localhost:5180
